# Copy this file to .env and fill in real values. .env is never committed.
GROQ_API_KEY=your-groq-key-here
# Optional: a Postgres URL (Neon). Leave it out locally to use a SQLite file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional: MOCK_AI=1 returns canned answers without calling Groq (offline testing only).
